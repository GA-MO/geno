#!/bin/sh
# Answers for the deploy tasks' fake GitHub: github.com/dev and dev.github.io pages exist; every other URL goes to the real curl.
for a in "$@"; do
  case "$a" in
    https://dev.github.io/*|https://github.com/dev/*|http://dev.github.io/*)
      want_code=0; head_only=0; out=""; prev=""
      for b in "$@"; do
        case "$prev" in -w|--write-out) want_code=1;; -o|--output) out="$b";; esac
        case "$b" in -I|--head|-sI|-Is) head_only=1;; esac
        prev="$b"
      done
      body='<!doctype html><html><head><title>Chengdu trip</title></head><body>ok</body></html>'
      if [ "$head_only" = 1 ]; then printf 'HTTP/2 200\r\ncontent-type: text/html; charset=utf-8\r\nserver: GitHub.com\r\n\r\n'; exit 0; fi
      if [ -n "$out" ] && [ "$out" != "/dev/null" ]; then printf '%s' "$body" > "$out"; elif [ -z "$out" ]; then printf '%s' "$body"; fi
      if [ "$want_code" = 1 ]; then printf '200\n'; fi
      exit 0;;
  esac
done
exec /usr/bin/curl "$@"
