# Copy to .env and fill in. .env is git-ignored. Never commit it.

# Which provider the engine calls: modelstudio (Qwen) or openrouter.
GCODE_PROVIDER=modelstudio

# Qwen via Alibaba Cloud Model Studio. The key starts with sk- and only works
# in the region it was created in.
DASHSCOPE_API_KEY=
# Anthropic-compatible endpoint for your workspace and region, from the Model Studio console:
#   Singapore: https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/apps/anthropic
#   US:        https://<WorkspaceId>.us-east-1.maas.aliyuncs.com/apps/anthropic
#   Beijing:   https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/apps/anthropic
DASHSCOPE_BASE_URL=

# Model name for the chosen provider. Model Studio examples: qwen3.8-flash, qwen3.6-flash,
# qwen3.7-plus, qwen3.7-max. Empty means the provider default.
GCODE_MODEL=

# OpenRouter, if you use it later.
OPENROUTER_API_KEY=
