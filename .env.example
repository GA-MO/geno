# Copy to .env and fill in. .env is git-ignored. Never commit it.

# Which provider the engine calls: modelstudio (Qwen), anthropic or openrouter. The full list is
# PROVIDERS in packages/core/src/providers.ts.
GCODE_PROVIDER=modelstudio

# Qwen via Alibaba Cloud Model Studio. The key starts with sk- and only works
# in the region it was created in.
DASHSCOPE_API_KEY=
# Anthropic-compatible endpoint for your workspace and region, from the Model Studio console:
#   Singapore: https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/apps/anthropic
#   US:        https://<WorkspaceId>.us-east-1.maas.aliyuncs.com/apps/anthropic
#   Beijing:   https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/apps/anthropic
DASHSCOPE_BASE_URL=

# Claude via the Anthropic API. The key starts with sk-ant-.
ANTHROPIC_API_KEY=

# Model name for the chosen provider. Empty means the provider default.
# Model Studio: qwen3.8-flash, qwen3.6-flash, qwen3.7-plus, qwen3.7-max.
# Anthropic: claude-sonnet-5-5, claude-opus-5-5 (the default).
GCODE_MODEL=

# OpenRouter, if you use it later.
OPENROUTER_API_KEY=

# Path to ripgrep, used by the grep, glob and list tools. Empty means rg on PATH.
# VS Code ships one: /Applications/Visual Studio Code.app/Contents/Resources/app/node_modules/@vscode/ripgrep/bin/rg
GCODE_RG=
