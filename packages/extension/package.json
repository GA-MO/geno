{
  "name": "g-code",
  "displayName": "g-code",
  "version": "0.3.0",
  "private": true,
  "publisher": "g-code",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "media"
  ],
  "enabledApiProposals": [
    "inlineCompletionsAdditions"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gcode.hello",
        "title": "g-code: Hello"
      },
      {
        "command": "gcode.chat.send",
        "title": "g-code: Ask for a Change"
      },
      {
        "command": "gcode.chat.stop",
        "title": "g-code: Stop the Chat Turn"
      },
      {
        "command": "gcode.setApiKey",
        "title": "g-code: Set API Key"
      },
      {
        "command": "gcode.tab.toggle",
        "title": "g-code: Toggle Tab"
      },
      {
        "command": "gcode.review.keep",
        "title": "Keep",
        "category": "g-code",
        "icon": "$(check)"
      },
      {
        "command": "gcode.review.undo",
        "title": "Undo",
        "category": "g-code",
        "icon": "$(discard)"
      },
      {
        "command": "gcode.review.keepFile",
        "title": "Keep All Changes in File",
        "category": "g-code",
        "icon": "$(check-all)"
      },
      {
        "command": "gcode.review.undoFile",
        "title": "Undo All Changes in File",
        "category": "g-code",
        "icon": "$(discard)"
      },
      {
        "command": "gcode.review.undoSession",
        "title": "Undo All Changes of the Session",
        "category": "g-code",
        "icon": "$(history)"
      },
      {
        "command": "gcode.review.openDiff",
        "title": "Open Diff Against Checkpoint",
        "category": "g-code",
        "icon": "$(diff)"
      },
      {
        "command": "gcode.review.reveal",
        "title": "Show Change",
        "category": "g-code"
      },
      {
        "command": "gcode.inlineEdit",
        "title": "Edit Selection (Cmd-K)",
        "category": "g-code"
      }
    ],
    "configuration": {
      "title": "g-code",
      "properties": {
        "gcode.provider": {
          "type": "string",
          "enum": [
            "modelstudio",
            "openrouter"
          ],
          "default": "modelstudio",
          "description": "The model provider for chat, review and Cmd-K. Run `g-code: Set API Key` to store its key."
        },
        "gcode.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Model Studio's Anthropic-compatible endpoint, which embeds your workspace id and region. OpenRouter ignores it."
        },
        "gcode.model": {
          "type": "string",
          "default": "",
          "description": "The model for chat, review and Cmd-K. Empty uses the provider's default (qwen3.8-flash on Model Studio)."
        },
        "gcode.tab.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show ghost-text completions from the local FIM model."
        },
        "gcode.tab.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8012",
          "description": "Base URL of the llama-server that serves Tab completions."
        },
        "gcode.tab.modelPath": {
          "type": "string",
          "default": "",
          "description": "The GGUF file the Tab model server loads. Empty uses ~/.g-code/models/qwen2.5-coder-1.5b-q8_0.gguf. When Tab is on and nothing answers at gcode.tab.endpoint, g-code starts llama-server with it, and stops it when VS Code closes."
        },
        "gcode.tab.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "description": "Milliseconds to wait after the last keystroke before asking the model."
        },
        "gcode.tab.nextEdit": {
          "type": "boolean",
          "default": false,
          "description": "Predict the next edit from recent edits with the local Zeta model, shown as inline edits. Needs VS Code Insiders with the inlineCompletionsAdditions proposal. Off by default because Zeta misses the latency bar on this Mac (docs/e9-e10-e11.md)."
        },
        "gcode.tab.nextEditEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8013",
          "description": "Base URL of the llama-server that serves next-edit predictions (scripts/next-edit-server.sh)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gcode",
          "title": "g-code",
          "icon": "media/chat.svg"
        }
      ]
    },
    "views": {
      "gcode": [
        {
          "type": "webview",
          "id": "gcode.chat",
          "name": "Chat",
          "initialSize": 3
        },
        {
          "id": "gcode.changes",
          "name": "Changes",
          "initialSize": 1
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gcode.review.undoSession",
          "when": "view == gcode.changes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gcode.review.openDiff",
          "when": "view == gcode.changes && viewItem =~ /^file/",
          "group": "inline@1"
        },
        {
          "command": "gcode.review.keepFile",
          "when": "view == gcode.changes && viewItem == file-pending",
          "group": "inline@2"
        },
        {
          "command": "gcode.review.undoFile",
          "when": "view == gcode.changes && viewItem == file-pending",
          "group": "inline@3"
        },
        {
          "command": "gcode.review.keep",
          "when": "view == gcode.changes && viewItem == hunk-pending",
          "group": "inline@1"
        },
        {
          "command": "gcode.review.undo",
          "when": "view == gcode.changes && viewItem == hunk-pending",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gcode.review.keep",
          "when": "false"
        },
        {
          "command": "gcode.review.undo",
          "when": "false"
        },
        {
          "command": "gcode.review.reveal",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gcode.inlineEdit",
        "key": "ctrl+k ctrl+i",
        "mac": "cmd+k cmd+i",
        "when": "editorTextFocus && resourceScheme == file"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "tsx build.mts",
    "package": "tsx build.mts package"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@g-code/core": "workspace:*",
    "@vscode/codicons": "0.0.46-24",
    "marked": "^18.0.14",
    "prismjs": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  }
}
