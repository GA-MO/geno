{
  "name": "g-code",
  "displayName": "g-code",
  "version": "0.0.0",
  "private": true,
  "publisher": "g-code",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "enabledApiProposals": [
    "inlineCompletionsAdditions"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gcode.hello",
        "title": "g-code: Hello"
      },
      {
        "command": "gcode.chat.send",
        "title": "g-code: Ask for a Change"
      },
      {
        "command": "gcode.chat.stop",
        "title": "g-code: Stop the Chat Turn"
      }
    ],
    "configuration": {
      "title": "g-code",
      "properties": {
        "gcode.tab.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show ghost-text completions from the local FIM model."
        },
        "gcode.tab.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8012",
          "description": "Base URL of the llama-server that serves Tab completions."
        },
        "gcode.tab.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "description": "Milliseconds to wait after the last keystroke before asking the model."
        },
        "gcode.tab.nextEdit": {
          "type": "boolean",
          "default": false,
          "description": "Predict the next edit from recent edits with the local Zeta model, shown as inline edits. Needs VS Code Insiders with the inlineCompletionsAdditions proposal. Off by default because Zeta misses the latency bar on this Mac (docs/e9-e10-e11.md)."
        },
        "gcode.tab.nextEditEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8013",
          "description": "Base URL of the llama-server that serves next-edit predictions (scripts/next-edit-server.sh)."
        },
        "gcode.engine.path": {
          "type": "string",
          "default": "",
          "description": "Path to the engine CLI (dist/cli.js) that the chat panel runs as `node <path> serve --stdio`. Empty uses the engine built next to this extension in the g-code repository."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gcode",
          "title": "g-code",
          "icon": "media/chat.svg"
        }
      ]
    },
    "views": {
      "gcode": [
        {
          "type": "webview",
          "id": "gcode.chat",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js && esbuild src/chat/webview.ts --bundle --platform=browser --format=iife --target=es2022 --outfile=dist/webview.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@g-code/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2"
  }
}
