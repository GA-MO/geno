{
  "name": "g-code",
  "displayName": "Geno",
  "version": "0.10.0",
  "private": true,
  "publisher": "g-code",
  "icon": "dist/dino/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "media"
  ],
  "enabledApiProposals": [
    "inlineCompletionsAdditions"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gcode.hello",
        "title": "Geno: Hello"
      },
      {
        "command": "gcode.chat.send",
        "title": "Geno: Ask for a Change"
      },
      {
        "command": "gcode.chat.stop",
        "title": "Geno: Stop the Chat Turn"
      },
      {
        "command": "gcode.chat.new",
        "title": "New Chat",
        "category": "Geno",
        "icon": "$(add)"
      },
      {
        "command": "gcode.chat.history",
        "title": "Chat History",
        "category": "Geno",
        "icon": "$(history)"
      },
      {
        "command": "gcode.chat.mcp",
        "title": "MCP Servers",
        "category": "Geno",
        "icon": "$(server-process)"
      },
      {
        "command": "gcode.chat.settings",
        "title": "Models and Keys",
        "category": "Geno",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gcode.setApiKey",
        "title": "Geno: Set API Key"
      },
      {
        "command": "gcode.tab.toggle",
        "title": "Geno: Toggle Tab"
      },
      {
        "command": "gcode.review.keep",
        "title": "Keep",
        "category": "Geno",
        "icon": "$(check)"
      },
      {
        "command": "gcode.review.undo",
        "title": "Undo",
        "category": "Geno",
        "icon": "$(discard)"
      },
      {
        "command": "gcode.review.keepFile",
        "title": "Keep All Changes in File",
        "category": "Geno",
        "icon": "$(check-all)"
      },
      {
        "command": "gcode.review.undoFile",
        "title": "Undo All Changes in File",
        "category": "Geno",
        "icon": "$(discard)"
      },
      {
        "command": "gcode.review.undoSession",
        "title": "Undo All Changes of the Session",
        "category": "Geno",
        "icon": "$(history)"
      },
      {
        "command": "gcode.review.openDiff",
        "title": "Open Diff Against Checkpoint",
        "category": "Geno",
        "icon": "$(diff)"
      },
      {
        "command": "gcode.review.reveal",
        "title": "Show Change",
        "category": "Geno"
      },
      {
        "command": "gcode.inlineEdit",
        "title": "Edit Selection (Cmd-K)",
        "category": "Geno"
      }
    ],
    "configuration": {
      "title": "Geno",
      "properties": {
        "gcode.provider": {
          "type": "string",
          "enum": [
            "modelstudio",
            "openrouter",
            "anthropic",
            "bedrock",
            "vertex",
            "openai",
            "azure-openai",
            "gemini",
            "deepseek",
            "groq",
            "cerebras",
            "xai",
            "mistral",
            "ollama",
            "lmstudio"
          ],
          "default": "modelstudio",
          "description": "The model provider for chat, review and Cmd-K. Set its key in Geno: Models and Keys, or with `Geno: Set API Key`."
        },
        "gcode.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Model Studio's Anthropic-compatible endpoint, which embeds your workspace id and region. Read from your user settings only. Other providers ignore it.",
          "scope": "application"
        },
        "gcode.model": {
          "type": "string",
          "default": "",
          "description": "The model for chat, review and Cmd-K. Empty uses the provider's default (qwen3.8-flash on Model Studio)."
        },
        "gcode.providers": {
          "type": "object",
          "scope": "application",
          "default": {},
          "markdownDescription": "Per-provider values that are not secret: a base URL override, an AWS region or profile, a Google Cloud project. Read from your user settings only, so a workspace cannot send your key elsewhere. Keys never go here: set them in **Geno: Models and Keys**, which keeps them in VS Code's secret storage.",
          "propertyNames": {
            "enum": [
              "openrouter",
              "modelstudio",
              "anthropic",
              "bedrock",
              "vertex",
              "openai",
              "azure-openai",
              "gemini",
              "deepseek",
              "groq",
              "cerebras",
              "xai",
              "mistral",
              "ollama",
              "lmstudio"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "profile": {
                "type": "string"
              },
              "project": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "gcode.roles": {
          "type": "object",
          "default": {},
          "markdownDescription": "Which provider and model each helper runs on. Chat runs on `gcode.provider` and `gcode.model`, and Tab on its local llama-server. A role left out keeps Geno's default.",
          "properties": {
            "classifier": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "openrouter",
                    "modelstudio",
                    "anthropic",
                    "bedrock",
                    "vertex",
                    "openai",
                    "azure-openai",
                    "gemini",
                    "deepseek",
                    "groq",
                    "cerebras",
                    "xai",
                    "mistral",
                    "ollama",
                    "lmstudio"
                  ]
                },
                "model": {
                  "type": "string"
                }
              },
              "required": [
                "provider"
              ],
              "additionalProperties": false,
              "description": "The Auto mode classifier, which judges commands no rule settles."
            },
            "explore": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "openrouter",
                    "modelstudio",
                    "anthropic",
                    "bedrock",
                    "vertex",
                    "openai",
                    "azure-openai",
                    "gemini",
                    "deepseek",
                    "groq",
                    "cerebras",
                    "xai",
                    "mistral",
                    "ollama",
                    "lmstudio"
                  ]
                },
                "model": {
                  "type": "string"
                }
              },
              "required": [
                "provider"
              ],
              "additionalProperties": false,
              "description": "The explore helper, once Geno has one."
            }
          },
          "additionalProperties": false
        },
        "gcode.approvalMode": {
          "type": "string",
          "enum": [
            "ask",
            "auto"
          ],
          "enumDescriptions": [
            "Ask before every command Geno's rules hold back.",
            "Run clearly safe commands on its own and let a classifier judge the rest. Geno still asks before deleting the workspace or its .git, touching paths outside it, git push, and downloads from other hosts."
          ],
          "default": "ask",
          "description": "The approval mode new chats start in. The picker in the composer switches the open chat."
        },
        "gcode.browser.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Let the agent drive a browser: Chrome through the chrome-devtools-mcp server, with a fresh profile thrown away after each chat. Pages on localhost, 127.0.0.1, [::1], *.localhost and *.test open without asking; any other site asks first, in Auto too. Chrome starts at the first browser step."
        },
        "gcode.browser.headless": {
          "type": "boolean",
          "default": true,
          "description": "Run the agent's browser without a window. Applies to new chats."
        },
        "gcode.ui.style": {
          "type": "string",
          "enum": [
            "glass",
            "native"
          ],
          "enumDescriptions": [
            "Dark glass panes over a soft gradient, with a running rainbow edge on the turn at work and the focused composer.",
            "VS Code's own colors and borders, as the Trail panel had before."
          ],
          "default": "glass",
          "description": "How the chat panel looks. High contrast themes always use the native style."
        },
        "gcode.chat.detail": {
          "type": "string",
          "enum": [
            "compact",
            "full"
          ],
          "enumDescriptions": [
            "Fold each finished turn's work into one summary line, and show only a running turn's last four steps. Click the line to see every step.",
            "Show every step of every turn, with tool arguments, timings and each turn's model, tokens and cost."
          ],
          "default": "compact",
          "description": "How much of each turn the chat shows. The answer, the files a turn changed, and anything waiting on you show either way."
        },
        "gcode.chat.bahtPerUsd": {
          "type": "number",
          "default": 33,
          "exclusiveMinimum": 0,
          "description": "Baht to one US dollar, for the cost the composer shows while a turn runs. The tooltip gives the cost in US dollars."
        },
        "gcode.ui.showChanges": {
          "type": "boolean",
          "default": false,
          "description": "Show Geno's Changes view under the chat. Off by default, since Source Control lists the same files; the chat's changes card and the editor's Keep and Undo lenses review edits either way."
        },
        "gcode.tab.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show ghost-text completions from the local FIM model."
        },
        "gcode.tab.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8012",
          "description": "Base URL of the llama-server that serves Tab completions."
        },
        "gcode.tab.modelPath": {
          "type": "string",
          "default": "",
          "description": "The GGUF file the Tab model server loads. Empty uses ~/.g-code/models/qwen2.5-coder-1.5b-q8_0.gguf. When Tab is on and nothing answers at gcode.tab.endpoint, Geno starts llama-server with it, and stops it when VS Code closes."
        },
        "gcode.tab.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "description": "Milliseconds to wait after the last keystroke before asking the model."
        },
        "gcode.tab.nextEdit": {
          "type": "boolean",
          "default": false,
          "description": "Predict the next edit from recent edits with the local Zeta model, shown as inline edits. Needs VS Code Insiders with the inlineCompletionsAdditions proposal. Off by default because Zeta misses the latency bar on this Mac (docs/e9-e10-e11.md)."
        },
        "gcode.tab.nextEditEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8013",
          "description": "Base URL of the llama-server that serves next-edit predictions (scripts/next-edit-server.sh)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gcode",
          "title": "Geno",
          "icon": "dist/dino/mono.svg"
        }
      ]
    },
    "views": {
      "gcode": [
        {
          "type": "webview",
          "id": "gcode.chat",
          "name": "Chat",
          "initialSize": 3
        },
        {
          "id": "gcode.changes",
          "name": "Changes",
          "initialSize": 1,
          "when": "config.gcode.ui.showChanges"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gcode.chat.new",
          "when": "view == gcode.chat",
          "group": "navigation@1"
        },
        {
          "command": "gcode.chat.history",
          "when": "view == gcode.chat",
          "group": "navigation@2"
        },
        {
          "command": "gcode.chat.mcp",
          "when": "view == gcode.chat",
          "group": "navigation@3"
        },
        {
          "command": "gcode.chat.settings",
          "when": "view == gcode.chat",
          "group": "navigation@4"
        },
        {
          "command": "gcode.review.undoSession",
          "when": "view == gcode.changes && config.gcode.ui.showChanges",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gcode.review.openDiff",
          "when": "view == gcode.changes && config.gcode.ui.showChanges && viewItem =~ /^file/",
          "group": "inline@1"
        },
        {
          "command": "gcode.review.keepFile",
          "when": "view == gcode.changes && config.gcode.ui.showChanges && viewItem == file-pending",
          "group": "inline@2"
        },
        {
          "command": "gcode.review.undoFile",
          "when": "view == gcode.changes && config.gcode.ui.showChanges && viewItem == file-pending",
          "group": "inline@3"
        },
        {
          "command": "gcode.review.keep",
          "when": "view == gcode.changes && config.gcode.ui.showChanges && viewItem == hunk-pending",
          "group": "inline@1"
        },
        {
          "command": "gcode.review.undo",
          "when": "view == gcode.changes && config.gcode.ui.showChanges && viewItem == hunk-pending",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gcode.review.keep",
          "when": "false"
        },
        {
          "command": "gcode.review.undo",
          "when": "false"
        },
        {
          "command": "gcode.review.reveal",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gcode.inlineEdit",
        "key": "ctrl+k ctrl+i",
        "mac": "cmd+k cmd+i",
        "when": "editorTextFocus && resourceScheme == file"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "tsx build.mts",
    "package": "tsx build.mts package"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@g-code/core": "workspace:*",
    "@vscode/codicons": "0.0.46-24",
    "marked": "^18.0.14",
    "mermaid": "^12.1.0",
    "prismjs": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  }
}
