---
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">{title}</h1>
{description !== undefined && <p class="page-lede">{description}</p>}

<style>
  h1 { margin-top: 1rem; font-size: var(--sl-text-h1); line-height: var(--sl-line-height-headings); font-weight: 650; letter-spacing: -0.02em; color: var(--sl-color-white); }
  .page-lede { margin: 0.5rem 0 0; max-width: 62ch; font-size: 1.05rem; line-height: 1.8; color: var(--ink-2); }
</style>
