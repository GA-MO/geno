---
import { siteFor } from '../scenario/site';

const site = siteFor();
const pages = Object.values(site.scenarios);
const chapterOf = (href: string) => href.split('/')[2];
---

<div class="index not-content">
  {
    site.catalog.chapters.map((chapter) => {
      const mine = pages.filter((page) => chapterOf(page.href) === chapter.prefix).sort((a, b) => a.title.localeCompare(b.title));
      return (
        <section class="index-chapter" id={`ch-${chapter.number}`}>
          <header>
            <h2>{chapter.thai}</h2>
            <span class="index-count">{mine.length} ทัวร์</span>
          </header>
          <ul class="card-grid">
            {mine.map((page) => (
              <li>
                <a class="card" href={page.href}>
                  <span class="card-title">{page.title}</span>
                  <span class={`card-state${page.story ? ' story' : ''}`}>{page.story ? 'มีเรื่องเล่า' : 'มีแต่ขั้นในโค้ด'}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>
