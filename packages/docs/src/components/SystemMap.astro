---
import { hopPath } from '../map/hop';
import { deriveMap, layoutMap } from '../map/map';
import { siteFor } from '../scenario/site';
import SystemMapFlow from './SystemMapFlow';

const site = siteFor();
const map = await layoutMap(deriveMap(site), site);
const top = 44;
const boxOf = (key: string) => map.nodes.find((node) => node.key === key)!;
const lanesOf = (process: string) => map.lanes.filter((lane) => site.lanes.lanes.find((candidate) => candidate.id === lane.lane)?.process === process);
---

<div class="map not-prose">
  <SystemMapFlow client:load map={map} />

  <div class="map-static-wrap">
    <figure class="map-static" style={`width: ${map.width + 8}px; height: ${map.height + top + 4}px`} aria-label="แผนที่ระบบของ Geno">
      {
        map.bands.map((band) => (
          <div class="map-band" style={`left: ${band.x}px; top: 0; width: ${band.w + 8}px; height: ${map.height + top + 4}px`}>
            {band.label}
          </div>
        ))
      }
      {
        map.lanes.map((lane) => (
          <div class={`map-lane party-${lane.party}`} style={`left: ${lane.x + 4}px; top: ${lane.y + top}px; width: ${lane.w}px; height: ${lane.h}px`}>
            {lane.label}
          </div>
        ))
      }
      <svg viewBox={`-4 ${-top} ${map.width + 8} ${map.height + top + 4}`} width={map.width + 8} height={map.height + top + 4} aria-hidden="true">
        {map.edges.filter((edge) => edge.backbone).map((edge) => <path class="map-static-edge" d={hopPath(boxOf(edge.from), boxOf(edge.to))} />)}
      </svg>
      {
        map.nodes.map((node) => (
          <div class={`map-part party-${node.party}${node.visits.length === 0 ? ' unvisited' : ''}`} style={`left: ${node.x + 4}px; top: ${node.y + top}px; width: ${node.w}px; height: ${node.h}px`}>
            <span>
              {node.label} <small>{node.visits.length}</small>
            </span>
          </div>
        ))
      }
    </figure>
  </div>

  <section class="map-list">
    <h2 id="ทุกส่วน">ทุกส่วนของระบบ</h2>
    {
      map.bands.map((band) => (
        <section>
          <h3>{band.label}</h3>
          {lanesOf(band.process).map((lane) => (
            <>
              <h4>{lane.label}</h4>
              <ul>
                {map.nodes
                  .filter((node) => node.lane === lane.lane)
                  .map((node) => (
                    <li>
                      <strong>{node.label}</strong>
                      {node.ref !== undefined && (
                        <>
                          {' '}
                          <a class="tour-ref" href={node.ref.url}>
                            {node.ref.path}:{node.ref.line}
                          </a>
                        </>
                      )}
                      {node.visits.length > 0 && (
                        <ul>
                          {node.visits.map((visit) => (
                            <li>
                              <a href={`${visit.href}#at=${visit.step}`}>{visit.title}</a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
              </ul>
            </>
          ))}
        </section>
      ))
    }
  </section>
</div>
