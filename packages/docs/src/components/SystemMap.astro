---
import { deriveMap, layoutMap } from '../map/map';
import { siteFor } from '../scenario/site';
import SystemMapFlow from './SystemMapFlow';

/** `<SystemMap />` on the map page: the island, a static SVG of the same layout, and the same map as nested lists. */
const site = siteFor();
const map = await layoutMap(deriveMap(site), site);
const top = 44;
const lanesOf = (process: string) => map.lanes.filter((lane) => site.lanes.lanes.find((candidate) => candidate.id === lane.lane)?.process === process);
---

<div class="map not-content">
  <SystemMapFlow client:load map={map} />

  <figure class="map-static-svg">
    <svg viewBox={`-8 ${-top} ${map.width + 16} ${map.height + top + 8}`} width={map.width + 16} role="img" aria-label="แผนที่ระบบของ Geno">
      {
        map.bands.map((band) => (
          <g>
            <rect class="map-svg-band" x={band.x - 6} y={-top} width={band.w + 12} height={map.height + top} rx="10"></rect>
            <text class="map-svg-band-label" x={band.x} y={-top + 18}>{band.label}</text>
          </g>
        ))
      }
      {
        map.lanes.map((lane) => (
          <g class={`party-${lane.party}`}>
            <rect class="map-svg-lane" x={lane.x} y={lane.y} width={lane.w} height={lane.h} rx="8"></rect>
            <text class="map-svg-lane-label" x={lane.x + 10} y={lane.y + 22}>{lane.label}</text>
          </g>
        ))
      }
      {map.edges.map((edge) => <polyline class={`map-svg-edge${edge.crossing ? ' crossing' : ''}`} points={edge.points.map((point) => `${point.x},${point.y}`).join(' ')}></polyline>)}
      {
        map.nodes.map((node) => (
          <g class={`party-${node.party}`}>
            <rect class="map-svg-part" x={node.x} y={node.y} width={node.w} height={node.h} rx="6"></rect>
            <text class="map-svg-part-label" x={node.x + node.w / 2} y={node.y + node.h / 2 + 5} text-anchor="middle">{node.label}</text>
          </g>
        ))
      }
    </svg>
  </figure>

  <section class="map-list">
    <h2 id="ทุกส่วน">ทุกส่วนของระบบ</h2>
    {
      map.bands.map((band) => (
        <section>
          <h3>{band.label}</h3>
          {lanesOf(band.process).map((lane) => (
            <>
              <h4>{lane.label}</h4>
              <ul>
                {map.nodes
                  .filter((node) => node.lane === lane.lane)
                  .map((node) => (
                    <li>
                      <strong>{node.label}</strong>
                      {node.ref !== undefined && (
                        <>
                          {' '}
                          <a class="tour-ref" href={node.ref.url}>
                            {node.ref.path}:{node.ref.line}
                          </a>
                        </>
                      )}
                      {node.visits.length > 0 && (
                        <ul>
                          {node.visits.map((visit) => (
                            <li>
                              <a href={`${visit.href}#at=${visit.step}`}>{visit.title}</a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
              </ul>
            </>
          ))}
        </section>
      ))
    }
  </section>
</div>
