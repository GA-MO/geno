diff --git a/test/debounce.test.js b/test/debounce.test.js
new file mode 100644
index 0000000..01109d5
--- /dev/null
+++ b/test/debounce.test.js
@@ -0,0 +1,48 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import debounce from '../vendor/lodash/debounce.js';
+
+const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+test('calls once with the last arguments after the wait elapses', async () => {
+  const calls = [];
+  const fn = debounce((x) => calls.push(x), 20);
+  fn(1);
+  fn(2);
+  fn(3);
+  assert.deepEqual(calls, []);
+  await sleep(60);
+  assert.deepEqual(calls, [3]);
+});
+
+test('leading option calls immediately at the start of a burst', async () => {
+  const calls = [];
+  const fn = debounce((x) => calls.push(x), 20, { leading: true, trailing: false });
+  fn(1);
+  fn(2);
+  await sleep(60);
+  assert.deepEqual(calls, [1]);
+});
+
+test('cancel stops a pending call', async () => {
+  const calls = [];
+  const fn = debounce(() => calls.push(1), 20);
+  fn();
+  fn.cancel();
+  await sleep(60);
+  assert.deepEqual(calls, []);
+});
+
+test('flush runs a pending call right away', async () => {
+  const calls = [];
+  const fn = debounce(() => calls.push(1), 20);
+  fn();
+  fn.flush();
+  assert.deepEqual(calls, [1]);
+  await sleep(60);
+  assert.deepEqual(calls, [1]);
+});
+
+test('rejects a non-function', () => {
+  assert.throws(() => debounce(undefined, 10), TypeError);
+});
