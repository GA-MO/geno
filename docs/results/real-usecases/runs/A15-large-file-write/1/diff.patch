diff --git a/test/levels.test.js b/test/levels.test.js
new file mode 100644
index 0000000..977dc1d
--- /dev/null
+++ b/test/levels.test.js
@@ -0,0 +1,13 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { LEVELS } from '../src/logic/levels.js';
+
+test('every maze is 31 rows of exactly 28 characters', () => {
+  assert.equal(LEVELS.length, 12);
+  for (const level of LEVELS) {
+    assert.equal(level.maze.length, 31, `level ${level.id} has ${level.maze.length} rows, expected 31`);
+    level.maze.forEach((row, i) => {
+      assert.equal(row.length, 28, `level ${level.id} row ${i} has ${row.length} chars, expected 28`);
+    });
+  }
+});
