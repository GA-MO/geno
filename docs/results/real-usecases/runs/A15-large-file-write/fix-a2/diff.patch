diff --git a/test/levels.test.js b/test/levels.test.js
new file mode 100644
index 0000000..bc4804a
--- /dev/null
+++ b/test/levels.test.js
@@ -0,0 +1,16 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { LEVELS } from '../src/logic/levels.js';
+
+test('there are 12 levels', () => {
+  assert.equal(LEVELS.length, 12);
+});
+
+test('every maze is 31 rows of exactly 28 characters', () => {
+  for (const level of LEVELS) {
+    assert.equal(level.maze.length, 31, `level ${level.id} (${level.name}) has ${level.maze.length} rows, expected 31`);
+    level.maze.forEach((row, i) => {
+      assert.equal(row.length, 28, `level ${level.id} (${level.name}) row ${i} has ${row.length} characters, expected 28`);
+    });
+  }
+});
