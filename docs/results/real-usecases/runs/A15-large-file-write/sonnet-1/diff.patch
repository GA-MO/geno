+++ b/test/levels.test.js
@@ -0,0 +1,17 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { LEVELS } from '../src/logic/levels.js';
+
+test('there are 12 levels', () => {
+  assert.equal(LEVELS.length, 12);
+});
+
+test('every maze is 31x28 and uses only valid tiles', () => {
+  for (const { id, maze } of LEVELS) {
+    assert.equal(maze.length, 31, `level ${id} rows`);
+    maze.forEach((row, y) => {
+      assert.equal(row.length, 28, `level ${id} row ${y} width`);
+      assert.match(row, /^[#.o ]+$/, `level ${id} row ${y} tiles`);
+    });
+  }
+});
