+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { MAZE } from '../src/scenes/PacmanScene.js';
+
+const COLS = 28;
+const ROWS = 31;
+const START = [13, 25];
+const HOUSE = [13, 12];
+
+const cell = (r, c) => MAZE[r][c];
+const wrapped = (c) => ((c % COLS) + COLS) % COLS;
+
+function reachable(startRow, startCol, doorPassable) {
+  const seen = new Set([startRow * COLS + startCol]);
+  const queue = [[startCol, startRow]];
+  for (let head = 0; head < queue.length; head++) {
+    const [c, r] = queue[head];
+    for (const [dx, dy] of [[0, -1], [0, 1], [-1, 0], [1, 0]]) {
+      const nr = r + dy;
+      const nc = wrapped(c + dx);
+      if (nr < 0 || nr >= ROWS) continue;
+      const ch = cell(nr, nc);
+      if (ch === '#' || (ch === '-' && !doorPassable)) continue;
+      const key = nr * COLS + nc;
+      if (!seen.has(key)) {
+        seen.add(key);
+        queue.push([nc, nr]);
+      }
+    }
+  }
+  return seen;
+}
+
+test('maze is 28 columns by 31 rows', () => {
+  assert.equal(MAZE.length, ROWS);
+  for (const row of MAZE) assert.equal(row.length, COLS);
+});
+
+test('maze is left-right symmetric', () => {
+  for (const row of MAZE) {
+    assert.equal(row, [...row].reverse().join(''));
+  }
+});
+
+test('maze has four power pellets and the tunnel row is open at both ends', () => {
+  const flat = MAZE.join('');
+  assert.equal([...flat].filter((ch) => ch === 'o').length, 4);
+  assert.notEqual(cell(15, 0), '#');
+  assert.notEqual(cell(15, COLS - 1), '#');
+});
+
+test('every pellet is reachable from the pacman start without crossing the door', () => {
+  const area = reachable(START[1], START[0], false);
+  for (let r = 0; r < ROWS; r++) {
+    for (let c = 0; c < COLS; c++) {
+      if (cell(r, c) === '.' || cell(r, c) === 'o') {
+        assert.ok(area.has(r * COLS + c), `pellet at row ${r} col ${c} is unreachable`);
+      }
+    }
+  }
+});
+
+test('the ghost house connects to the maze through the door', () => {
+  const area = reachable(HOUSE[1], HOUSE[0], true);
+  assert.ok(area.has(9 * COLS + 13), 'ghosts cannot reach the chamber above the door');
+  assert.ok(area.has(START[1] * COLS + START[0]), 'ghosts cannot reach the pacman start row');
+});
