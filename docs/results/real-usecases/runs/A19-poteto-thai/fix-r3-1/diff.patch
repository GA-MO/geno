diff --git a/src/logic/score.js b/src/logic/score.js
index 7d1a666..5836cde 100644
--- a/src/logic/score.js
+++ b/src/logic/score.js
@@ -1,5 +1,7 @@
 export const createState = () => ({ coins: 0, score: 0 });
 
+export const POINTS_PER_COIN = 10;
+
 export function collectCoin(state) {
-  return { ...state, coins: state.coins + 1 };
+  return { ...state, coins: state.coins + 1, score: state.score + POINTS_PER_COIN };
 }
diff --git a/src/scenes/GameScene.js b/src/scenes/GameScene.js
index 89f9851..3cd5f27 100644
--- a/src/scenes/GameScene.js
+++ b/src/scenes/GameScene.js
@@ -7,6 +7,7 @@ export class GameScene extends Phaser.Scene {
   }
 
   create() {
+    this.scoreText = this.add.text(16, 16, `Score: ${this.state.score}`, { fontSize: '24px', color: '#ffffff' });
     this.player = this.add.rectangle(400, 300, 24, 24, 0xffcc00);
     this.physics.add.existing(this.player);
     this.coins = this.physics.add.group();
@@ -14,6 +15,7 @@ export class GameScene extends Phaser.Scene {
     this.physics.add.overlap(this.player, this.coins, (_player, coin) => {
       coin.destroy();
       this.state = collectCoin(this.state);
+      this.scoreText.setText(`Score: ${this.state.score}`);
     });
     this.cursors = this.input.keyboard.createCursorKeys();
   }
diff --git a/test/score.test.js b/test/score.test.js
index 9fe2f9e..333ebe3 100644
--- a/test/score.test.js
+++ b/test/score.test.js
@@ -5,3 +5,23 @@ import { collectCoin, createState } from '../src/logic/score.js';
 test('collecting a coin counts it', () => {
   assert.equal(collectCoin(createState()).coins, 1);
 });
+
+test('a new game starts at zero score', () => {
+  assert.equal(createState().score, 0);
+});
+
+test('collecting one coin adds 10 points', () => {
+  assert.equal(collectCoin(createState()).score, 10);
+});
+
+test('collecting two coins adds 20 points and counts both', () => {
+  const afterTwo = collectCoin(collectCoin(createState()));
+  assert.equal(afterTwo.score, 20);
+  assert.equal(afterTwo.coins, 2);
+});
+
+test('collecting a coin does not change the old state', () => {
+  const before = createState();
+  collectCoin(before);
+  assert.deepEqual(before, { coins: 0, score: 0 });
+});
