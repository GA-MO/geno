diff --git a/test/score.test.js b/test/score.test.js
index 9fe2f9e..ade01a2 100644
--- a/test/score.test.js
+++ b/test/score.test.js
@@ -5,3 +5,15 @@ import { collectCoin, createState } from '../src/logic/score.js';
 test('collecting a coin counts it', () => {
   assert.equal(collectCoin(createState()).coins, 1);
 });
+
+test('each coin is worth 10 points', () => {
+  const one = collectCoin(createState());
+  assert.equal(one.score, 10);
+  assert.equal(collectCoin(one).score, 20);
+});
+
+test('score does not touch the previous state', () => {
+  const before = createState();
+  collectCoin(before);
+  assert.equal(before.score, 0);
+});
