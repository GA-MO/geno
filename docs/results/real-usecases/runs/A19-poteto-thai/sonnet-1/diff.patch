diff --git a/test/score.test.js b/test/score.test.js
index 9fe2f9e..ac39876 100644
--- a/test/score.test.js
+++ b/test/score.test.js
@@ -5,3 +5,14 @@ import { collectCoin, createState } from '../src/logic/score.js';
 test('collecting a coin counts it', () => {
   assert.equal(collectCoin(createState()).coins, 1);
 });
+
+test('each coin is worth 10 points', () => {
+  const state = collectCoin(collectCoin(collectCoin(createState())));
+  assert.equal(state.score, 30);
+});
+
+test('collecting a coin does not mutate the previous state', () => {
+  const before = createState();
+  collectCoin(before);
+  assert.deepEqual(before, { coins: 0, score: 0 });
+});
