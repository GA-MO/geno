diff --git a/test/score.test.js b/test/score.test.js
index 9fe2f9e..cb99c6b 100644
--- a/test/score.test.js
+++ b/test/score.test.js
@@ -5,3 +5,13 @@ import { collectCoin, createState } from '../src/logic/score.js';
 test('collecting a coin counts it', () => {
   assert.equal(collectCoin(createState()).coins, 1);
 });
+
+test('each coin is worth 10 points', () => {
+  assert.equal(collectCoin(createState()).score, 10);
+});
+
+test('points stack across coins', () => {
+  const state = collectCoin(collectCoin(createState()));
+  assert.equal(state.score, 20);
+  assert.equal(state.coins, 2);
