+const DURATION_RE = /^(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/;
+
 /** Parses a duration such as "1h30m", "45s" or "2d" into seconds. Throws on anything else. */
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const match = DURATION_RE.exec(text.replace(/\s+/g, ''));
+  if (!match || !match[0]) {
+    throw new Error(`invalid duration: ${text}`);
+  }
+  const [days, hours, minutes, seconds] = [1, 2, 3, 4].map((g) => (match[g] ? Number(match[g]) : 0));
+  return days * 86400 + hours * 3600 + minutes * 60 + seconds;
 }
