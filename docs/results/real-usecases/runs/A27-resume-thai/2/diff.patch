+const SECONDS_PER_UNIT: Record<string, number> = { s: 1, m: 60, h: 3600, d: 86400 };
+
 /** Parses a duration such as "1h30m", "45s" or "2d" into seconds. Throws on anything else. */
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  if (!/^\s*(?:\d+[dhms]\s*)+$/.test(text)) {
+    throw new Error(`invalid duration: ${text}`);
+  }
+  let total = 0;
+  for (const [, count, unit] of text.matchAll(/(\d+)([dhms])/g)) {
+    total += Number(count) * SECONDS_PER_UNIT[unit];
+  }
+  return total;
 }
