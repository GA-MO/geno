--- a/src/duration.ts
+++ b/src/duration.ts
@@ -1,4 +1,17 @@
+const UNITS: Record<string, number> = { d: 86400, h: 3600, m: 60, s: 1 };
+
 /** Parses a duration such as "1h30m", "45s" or "2d" into seconds. Throws on anything else. */
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  let total = 0;
+  let rest = text;
+  let matched = false;
+  while (rest.length > 0) {
+    const m = /^(\d+)\s*([dhms])\s*/.exec(rest);
+    if (!m) throw new Error(`invalid duration: ${text}`);
+    total += Number(m[1]) * UNITS[m[2]];
+    rest = rest.slice(m[0].length);
+    matched = true;
+  }
+  if (!matched) throw new Error(`invalid duration: ${text}`);
+  return total;
 }
