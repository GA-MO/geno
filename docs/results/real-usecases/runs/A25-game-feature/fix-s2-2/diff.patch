diff --git a/test/score.test.js b/test/score.test.js
index 9fe2f9e..37712a9 100644
--- a/test/score.test.js
+++ b/test/score.test.js
@@ -1,7 +1,24 @@
 import { test } from 'node:test';
 import assert from 'node:assert/strict';
-import { collectCoin, createState } from '../src/logic/score.js';
+import { collectCoin, createState, togglePause } from '../src/logic/score.js';
 
 test('collecting a coin counts it', () => {
   assert.equal(collectCoin(createState()).coins, 1);
 });
+
+test('new game starts unpaused', () => {
+  assert.equal(createState().paused, false);
+});
+
+test('togglePause flips the pause flag back and forth', () => {
+  const paused = togglePause(createState());
+  assert.equal(paused.paused, true);
+  assert.equal(togglePause(paused).paused, false);
+});
+
+test('togglePause does not mutate or disturb other state', () => {
+  const state = collectCoin(createState());
+  togglePause(state);
+  assert.equal(state.paused, false);
+  assert.equal(togglePause(state).coins, 1);
+});
