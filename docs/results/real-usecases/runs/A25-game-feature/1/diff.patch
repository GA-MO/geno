     for (let i = 0; i < 8; i++) this.coins.add(this.add.circle(80 + i * 90, 120, 8, 0xffffff));
     this.physics.add.overlap(this.player, this.coins, (_player, coin) => {
+      if (this.state.paused) return;
       coin.destroy();
       this.state = collectCoin(this.state);
