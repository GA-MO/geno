@@ -0,0 +1,25 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { clamp } from '../src/clamp.ts';
+import * as index from '../src/index.ts';
+
+test('returns the value when it is inside the range', () => {
+  assert.equal(clamp(5, 0, 10), 5);
+  assert.equal(clamp(-1, -10, 10), -1);
+  assert.equal(clamp(2.5, 0, 3), 2.5);
+});
+
+test('returns the bounds at the edges', () => {
+  assert.equal(clamp(0, 0, 10), 0);
+  assert.equal(clamp(10, 0, 10), 10);
+});
+
+test('clamps values outside the range', () => {
+  assert.equal(clamp(-8, 0, 10), 0);
+  assert.equal(clamp(42, 0, 10), 10);
+  assert.equal(clamp(1000, -10, -5), -5);
+});
+
+test('is exported from the package entry point', () => {
+  assert.equal(index.clamp(11, 0, 10), 10);
+});
