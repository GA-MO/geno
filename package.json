{
  "name": "g-code",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:vscode": "tsx scripts/test-vscode.ts",
    "test:vscode:docker": "sh scripts/test-vscode-docker.sh",
    "test:all": "pnpm typecheck && pnpm lint:deps && pnpm build && pnpm vitest run --project unit --project webview && pnpm test:vscode:docker",
    "lint:deps": "tsx scripts/boundaries.ts",
    "package": "pnpm --filter ./packages/extension package",
    "gcode": "tsx packages/engine/src/cli.ts",
    "tab:bench": "tsx scripts/tab-bench.mjs",
    "test:affected": "tsx scripts/test-affected.ts",
    "test:golden": "vitest run --project unit packages/engine/test/golden",
    "ui": "tsx packages/extension/test/gallery/server.mts",
    "web": "pnpm --filter ./packages/extension build && pnpm --filter ./packages/web build && node packages/web/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
