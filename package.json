{
  "name": "g-code",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:vscode:docker": "sh scripts/test-vscode-docker.sh",
    "lint:deps": "tsx scripts/boundaries.ts",
    "package": "pnpm --filter ./packages/extension package",
    "gcode": "tsx packages/engine/src/cli.ts",
    "tab:bench": "tsx scripts/tab-bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
